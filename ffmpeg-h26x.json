{
    "name": "ffmpeg-h26x",
    "description": "ffmpeg H.261, H.263 and Sorenson H.263 decoder",
    "filters": [
        "ffdec",
        "rfh263"
    ],
    "help": "This is a reduced version of ffmpeg carrying the H.261, H.263 and Sorenson H.263 (FLV1) decoders only: the ITU-T video recommendations that predate MPEG-4 AVC, and the variant of H.263 that Flash Video shipped with.",
    "support": [
        "video"
    ],
    "sources": "https://bevara.ddns.net/sources/ffmpeg-h26x.accessor",
    "filter_source": {
        "ffdec": "ff_dec-h26x.c",
        "rfh263": "reframe_h263.c"
    },
    "Format": [
        "H261",
        "H263",
        "FLV1"
    ],
    "extension": {
        "263": "canvas",
        "h263": "canvas"
    },
    "using": ["solver_1"],
    "runtime": {
        "ffdec": {
            "outputs": [
                {
                    "property": "GF_PROP_PID_PIXFMT",
                    "format": [
                        "GF_PIXEL_YUV"
                    ]
                }
            ]
        }
    },
    "patents": {
        "status": "expired",
        "note": "H.261, H.263, Sorenson H.263",
        "checked": "2026-10-16"
    }
}
